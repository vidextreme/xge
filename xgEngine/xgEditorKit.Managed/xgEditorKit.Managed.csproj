<Project Sdk="Microsoft.NET.Sdk">

  <!-- Editor API for game projects' editor assemblies (Assets/**/Editor/): PropertyDrawer, SerializedProperty,
       EditorGUI. Installed into gameroot/sdk/lib. Never referenced by runtime assemblies or the player build. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>xg.editor</RootNamespace>

    <OutputPath>..\..\gameroot\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PropertyDrawer.cs" />
    <Compile Include="Selection.cs" />
    <Compile Include="EnumDescriptions.cs" />
    <Compile Include="AssetRef.cs" />
    <Compile Include="assets\JSONFile.cs" />
    <Compile Include="assets\AssetMeta.cs" />
    <Compile Include="assets\AssetReconciler.cs" />
    <Compile Include="assets\AssetItems.cs" />
    <Compile Include="assets\AssetMetaMigration.cs" />
    <Compile Include="assets\ChunkFile.cs" />
    <Compile Include="assets\AssetPipeline.cs" />
    <Compile Include="assets\TextureFormats.cs" />
    <Compile Include="assets\TextureAssets.cs" />
    <Compile Include="tools\ToolUsability.cs" />
    <Compile Include="tools\ITool.cs" />
    <Compile Include="tools\EditorTool.cs" />
    <Compile Include="tools\ToolDriver.cs" />
    <Compile Include="tools\ToolSelection.cs" />
    <Compile Include="tools\ToolView.cs" />
    <Compile Include="tools\PanelTools.cs" />
    <Compile Include="tools\InspectorTools.cs" />
    <Compile Include="tools\ToolAttributes.cs" />
    <Compile Include="tools\ToolEvents.cs" />
    <Compile Include="tools\PointerEventData.cs" />
    <Compile Include="tools\SceneViewContext.cs" />
    <Compile Include="tools\ToolUndo.cs" />
    <Compile Include="tools\ToolToggleStore.cs" />
    <Compile Include="tools\Tools.cs" />
    <Compile Include="tools\SelectTool.cs" />
    <Compile Include="tools\SelectionCommands.cs" />
    <Compile Include="SerializedProperty.cs" />
    <Compile Include="SerializedObject.cs" />
    <Compile Include="TypeBridge.cs" />
    <Compile Include="ComponentIcons.cs" />
    <Compile Include="ComponentCatalog.cs" />
    <Compile Include="DrawerRegistry.cs" />
    <Compile Include="EditorGUI.cs" />
    <Compile Include="BuiltinDrawers.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\xgSharedKit.Managed\xgSharedKit.Managed.csproj" />
    <ProjectReference Include="..\xgImUIKit.Managed\xgImUIKit.Managed.csproj" />
  </ItemGroup>

  <!-- Installs the editor API and the UI kit binding next to xgSharedKit.Managed in gameroot\sdk\lib, where the
       generated <Name>.Editor.csproj of a game project references them. -->
  <Target Name="XgeInstallEditorSdk" AfterTargets="Build">
    <ItemGroup>
      <XgeEditorSdkLib Include="$(TargetPath)" />
      <XgeEditorSdkLib Include="$(TargetDir)xgImUIKit.Managed.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(XgeEditorSdkLib)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\gameroot\sdk\lib\" SkipUnchangedFiles="true" />
  </Target>

</Project>
