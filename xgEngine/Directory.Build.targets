<Project>
  <!-- Runs only in xgReflectGen's Clean: it is the root of every code generator's build dependency chain,
       so a solution Clean/Rebuild sweeps once, before any project regenerates its files -->
  <Target Name="GlobalEngineWorkspaceClean"
          BeforeTargets="BeforeClean;Clean;CoreClean;CppClean;BeforeCppClean"
          Condition="'$(MSBuildProjectName)' == 'xgReflectGen'">

    <PropertyGroup>
      <EngineWorkspaceRoot>$(MSBuildThisFileDirectory)</EngineWorkspaceRoot>
    </PropertyGroup>

    <Message Text="XGE Master Engine Sweep --&gt; Scanning workspace tree: '$(EngineWorkspaceRoot)'" 
             Importance="high" />

    <!-- POWERSHELL SWEEP: Swapped outer string wrappers to single quotes to prevent text evaluation mangling. 
         Added -ErrorAction SilentlyContinue to Remove-Item to silently handle rapid file mutations. -->
    <Exec Command="powershell.exe -NoProfile -Command &quot;Get-ChildItem -Path '$(EngineWorkspaceRoot)' -Recurse -Filter '*.generated.*' -ErrorAction SilentlyContinue | Where-Object { %24_.DirectoryName -match '\\Generated%24' } | ForEach-Object { Write-Output ('XGE GLOBAL WIPE --&gt; DELETED: ' + %24_.Directory.Parent.Name + '\Generated\' + %24_.Name); Remove-Item %24_.FullName -Force -ErrorAction SilentlyContinue }&quot;"
          ContinueOnError="true" />
             
  </Target>
</Project>
