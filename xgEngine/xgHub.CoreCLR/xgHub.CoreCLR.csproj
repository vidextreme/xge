<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>..\..\gameroot\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\xgSharedKit.Managed\xgSharedKit.Managed.csproj" />
    <ProjectReference Include="..\xgImUIKit.Managed\xgImUIKit.Managed.csproj" />
  </ItemGroup>

  <!-- Writes gameroot/bin/xgHub.lnk: opens the Project Hub through headless conhost.exe, so no console window appears. -->
  <Target Name="XGEHubShortcut" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)HubShortcut.ps1&quot; -BinDir &quot;$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\gameroot\bin'))&quot;" ContinueOnError="true" />
  </Target>

</Project>
