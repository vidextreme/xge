<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Output directly to parent folder -->
    <OutputPath>..\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Outside Windows the apphost would be named tools/xgReflectGen, which is this project's folder -->
    <UseAppHost Condition="'$(OS)' != 'Windows_NT'">false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="EnumExtractor.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="StructExtractor.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TreeSitter">
      <HintPath>..\..\3rdparty\TreeSitter\TreeSitter.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <TreeSitterNative Include="$(ProjectDir)..\..\3rdparty\TreeSitter\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TreeSitterNative)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
