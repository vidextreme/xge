<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- xgScriptNative.dll is loaded from gameroot/bin at runtime (see ResolveNative in Program.cs) -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\xgSharedKit.Managed\xgSharedKit.Managed.csproj" />
  </ItemGroup>

  <!-- Pure asset meta logic from xgEditorKit.Managed, linked so it runs without the UI kit. -->
  <ItemGroup>
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\JSONFile.cs" Link="assets\JSONFile.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetMeta.cs" Link="assets\AssetMeta.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetReconciler.cs" Link="assets\AssetReconciler.cs" />
  </ItemGroup>

</Project>
