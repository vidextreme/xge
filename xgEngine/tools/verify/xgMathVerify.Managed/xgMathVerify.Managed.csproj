<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- xgScriptNative.dll is loaded from gameroot/bin at runtime (see ResolveNative in Program.cs) -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\xgSharedKit.Managed\xgSharedKit.Managed.csproj" />
  </ItemGroup>

  <!-- Pure asset meta logic from xgEditorKit.Managed, linked so it runs without the UI kit. -->
  <ItemGroup>
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\JSONFile.cs" Link="assets\JSONFile.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetMeta.cs" Link="assets\AssetMeta.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetMetaStore.cs" Link="assets\AssetMetaStore.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetReconciler.cs" Link="assets\AssetReconciler.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetItems.cs" Link="assets\AssetItems.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetMetaMigration.cs" Link="assets\AssetMetaMigration.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\ChunkFile.cs" Link="assets\ChunkFile.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\AssetPipeline.cs" Link="assets\AssetPipeline.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\TextureFormats.cs" Link="assets\TextureFormats.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\TextureAssets.cs" Link="assets\TextureAssets.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\MeshAssets.cs" Link="assets\MeshAssets.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\PrimitiveAssets.cs" Link="assets\PrimitiveAssets.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\ShaderAssets.cs" Link="assets\ShaderAssets.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\MaterialAssets.cs" Link="assets\MaterialAssets.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\ObjectAssets.cs" Link="assets\ObjectAssets.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\assets\SceneAssets.cs" Link="assets\SceneAssets.cs" />
  </ItemGroup>

  <!-- Tool selections, drivers and view state, which have no UI dependency. -->
  <ItemGroup>
    <Compile Include="..\..\..\xgEditorKit.Managed\tools\ToolUsability.cs" Link="tools\ToolUsability.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\tools\ITool.cs" Link="tools\ITool.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\tools\ToolDriver.cs" Link="tools\ToolDriver.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\tools\ToolSelection.cs" Link="tools\ToolSelection.cs" />
    <Compile Include="..\..\..\xgEditorKit.Managed\tools\ToolView.cs" Link="tools\ToolView.cs" />
  </ItemGroup>

</Project>
